# Backend Port
PORT=5000
NODE_ENV=development

# Groq API Key (Get free key from https://console.groq.com)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# JWT Secret for User Authentication
JWT_SECRET=ai-assistant-super-secret-jwt-key-2026

# Secret key for signing device registration tokens
DEVICE_TOKEN_SECRET=device-pairing-secret-key-2026

# Frontend Client URL
CLIENT_URL=http://localhost:5173
